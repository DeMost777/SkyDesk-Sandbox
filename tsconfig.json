{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // Same alias as tsconfig.app.json. Storybook's components manifest resolves imports
  // from this file; without it every component importing '@/…' has no props for agents.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
